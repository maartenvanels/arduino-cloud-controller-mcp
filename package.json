{
  "name": "arduino-cloud-mcp",
  "version": "1.0.0",
  "description": "Arduino Cloud Controller for Model Context Protocol",
  "main": "mcp-arduino-cloud.js",
  "type": "module",
  "scripts": {
    "start": "node mcp-arduino-cloud.js",
    "test": "node mcp-arduino-cloud.js --test",
    "list-devices": "node mcp-arduino-cloud.js --test list-devices",
    "list-things": "node mcp-arduino-cloud.js --test list-things",
    "dev": "nodemon mcp-arduino-cloud.js",
    "test:office": "node test/office-light.js",
    "control:office": "node test/control-office-light.js"
  },
  "keywords": [
    "arduino",
    "iot",
    "cloud",
    "mcp",
    "model-context-protocol"
  ],
  "author": "Open Source Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maartenvanels/arduino-cloud-controller-mcp"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "0.1.5",
    "dotenv": "16.0.3",
    "node-fetch": "3.3.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
}
